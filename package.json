{
  "name": "santiye-patronu",
  "version": "1.0.0",
  "description": "Şantiye Patronu Windows masaüstü oyunu",
  "author": "Şantiye Patronu",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/santiye-patronu.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "publish:win": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "build": {
    "appId": "com.santiye.patronu",
    "productName": "Şantiye Patronu",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SantiyePatronu-Setup-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Şantiye Patronu",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "santiye-patronu",
        "releaseType": "release"
      }
    ]
  }
}
